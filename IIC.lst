 117   3                   {          
 118   4                    if(SMB_num)
 119   4                     {                  
 120   5                       SMB0DAT = *SMB_Dat;   //如果为写操作则将数据写入SMB0DAT.
 121   5                       SMB_Dat++;   
 122   5                       SMB_num--;                 
 123   5                     }
 124   4                    else                           //如果数据写入完毕则发送停止信号.
 125   4                     { 
 126   5                       STO = 1;
 127   5                       SM_BUSY = 0; 
 128   5                     }
 129   4                   } 
 130   3                 }          
 131   2               break;
 132   2                             
 133   2            case  0x40:            //发送从地址 + R 后收到 ACK              //选择地址读
 134   2               if(SMB_num == 1)    //如果只读一个字节则将应答位AA清0，
 135   2                  AA = 0;          //收到数据以后不发送应答位               
 136   2                                            
 137   2               break; 
 138   2               
 139   2            case  0x50:            //收到数据字节 后已发送ACK    
 140   2              if(SMB_num>2)
 141   2                  {                
 142   3                    *SMB_Dat = SMB0DAT;  
 143   3                    SMB_Dat++;
 144   3                    SMB_num--;
 145   3                    AA=1;           
 146   3                  }
 147   2               else if(SMB_num == 2)  //最后一个字节
 148   2                  { 
 149   3                    *SMB_Dat = SMB0DAT;  
 150   3                    SMB_Dat++;
 151   3                    SMB_num--;
 152   3                    AA=0;              //清除AA
 153   3                  }                             
 154   2                break;
 155   2                
 156   2            case  0x58:                //收到数据字节 后已发送NACK 
 157   2               *SMB_Dat = SMB0DAT;
 158   2               STO = 1;
 159   2               SM_BUSY = 0; 
 160   2               read_sign = 0;          //数据读完之后清零标志位              
 161   2               break;
 162   2               
 163   2            default:                  //报警
 164   2               STO = 1;                         
 165   2               SM_BUSY = 0;
 166   2               eeprom_err=1;
 167   2               break;
 168   2           }
 169   1         SI=0;            // 清除中断标志
 170   1         EA = 1;
 171   1      }
