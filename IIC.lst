  79   2                STA = 0;                      
  80   2               break;
  81   2               
  82   2            case  0x10:   
  83   2              if (read_sign == 1)          
  84   2               SMB0DAT = chip_addr | 0x01; //重复起始位
  85   2              else 
  86   2               SMB0DAT = SMBMODE;
  87   2               STA = 0;
  88   2               break;
  89   2               
  90   2            case 0x18:  
  91   2                  SMB0DAT = (uchar)(start_adr >> 8);
  92   2                  addr_num = 2;       
  93   2               break;
  94   2               
  95   2            case  0x28:   
  96   2               if (read_sign == 1){
  97   3                 if (read_flg == 1)       //片内低字节伪写       
  98   3                 { 
  99   4                   read_flg = 2;
 100   4                   SMB0DAT = (uchar)start_adr; 
 101   4                 }  
 102   3                 else if (read_flg == 2)               //为读操作则重新启动总线.
 103   3                 { 
 104   4                   STO = 0;
 105   4                   STA = 1;
 106   4                   break;
 107   4                 }
 108   3               }
 109   2               else 
 110   2                {     
 111   3                 if (addr_num == 2)               //片内地址第二个字节
 112   3                   {
 113   4                     addr_num = 0;
 114   4                     SMB0DAT = (uchar)start_adr; 
 115   4                   }  
 116   3                 else if (addr_num == 0)
