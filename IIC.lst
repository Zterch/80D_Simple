  20          void init_smbus(void)
  21          {
  22   1          SMB0CN    = 0x44;        //允许SMBUS, 应答返回AA(低电平有效)
  23   1          //SMB0CR    = 0xF0;        //配置传送速度,-(SYSCLK/2*SCL_BAUD);IIC总线速率寄存器SCL=100K  
  24   1          SMB0CR    = 116;         // 配置传送速度,SYSCLK/(2*(256-SMB0CR+2.5)) = 77.6K
  25   1          EIE1     |= 0x02;        //使能SMBUS中断
  26   1          EIP1     |= 0x02;        //设置SMBUS中断为高优先级
  27   1      } 
  28          
  29          void write_data(unsigned char chip, unsigned int wordadr, uchar *dat, unsigned char number)
  30          { 
  31   1        addr_num = 0;
  32   1        SI = 0;
  33   1        SMB_num=number;          // 确定写数据大小
  34   1        while (SM_BUSY);         // 若SMBUS忙碌就等待
  35   1        SM_BUSY = 1;             // SM_BUSY是忙碌标志位 
  36   1        SMBMODE = chip & 0xfe;
  37   1        start_adr = wordadr;       // 装载写字节起始地址
  38   1        SMB_Dat = dat;
  39   1        STO = 0;
  40   1        STA = 1;  
  41   1        while (SM_BUSY);
  42   1        if(eeprom_err){
  43   2          eeprom_eror();
  44   2          eeprom_err=0;
  45   2         }   
  46   1       }
  47          
  48          void   read_data(unsigned char chip, unsigned int wordadr, uchar *dat, unsigned char number)
  49          { 
  50   1         SI = 0;
  51   1         SMB_num = number;          //确定写数据大小
  52   1         while (SM_BUSY);           // 若SMBUS忙碌就等待
  53   1         SM_BUSY = 1;               // SM_BUSY是忙碌标志位 
  54   1         read_sign = 1;             //置"1"开始伪写操作
