  20          /*
  21          ================================================================================
  22          * Name        : UART0_Init( )
  23          * Description : Initialize the UART0, baudrate
  24          * Input       : None
  25          * Output      : None
  26          * Note        : None
  27          ================================================================================
  28          */
  29          
  30          void UART0_Init( void )
  31          { 
  32   1        
  33   1         SCON0   = 0x50;                     // SCON0: mode 1, 8-bit UART, enable RX
  34   1         TMOD   |= 0x20;                     // TMOD: timer 1, mode 2, 8-bit reload
  35   1         TH1    = 256-(SYSCLK/BAUDRATE/16);     // set Timer1 reload value for baudrate
  36   1         TR1    = 1;                         // start Timer1
  37   1         CKCON  = 0x10;                      // Timer1 uses SYSCLK as time base
  38   1         PCON  |= 0x80;                      // SMOD00 = 1
  39   1         TI0    = 1;                         // Indicate TX0 ready
  40   1         IE |= 0x10;
  41   1       
  42   1      }
  43          
  44          static UART0_ISR( void ) interrupt 4
  45          {  
  46   1         EA = 0;
  47   1          if( SCON0 & ( 1<<1 ) )
  48   1          {
  49   2              //TX ok
  50   2              SCON0 &= ~( 1<<1 );
  51   2                      if( SendCount != 0 )
  52   2                      {
  53   3                              SBUF0 = *Ptr_Send++;
  54   3                              SendCount--;
