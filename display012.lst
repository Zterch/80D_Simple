  55   3                              busy = 1;
  56   3                      } 
  57   2                      else
  58   2                      {
  59   3                              busy = 0;
  60   3                      }
  61   2      
  62   2          }
  63   1          else if( SCON0 & ( 1<<0 ) )
  64   1          { 
  65   2              //RX ok
  66   2              SCON0 &= ~( 1<<0 );
  67   2              rbuf[RevCount] = SBUF0;
  68   2                      if(rbuf[0]==0x5a)
  69   2                      
  70   2                              
  71   2                        RevCount++;           
  72   2                      if(RevCount==9)
  73   2                              {
  74   3                        if (rbuf[0]==0x5A&&rbuf[1]==0xa5&&rbuf[2]==0x06&&rbuf[3]==0x83&&rbuf[4]==0x00&&rbuf[6]==0x01&&rbuf[7]=
             -=0x00)
  75   3                           rinterrupt = rinterrupt_Yes;
  76   3                          
  77   3                               RevCount=0;
  78   3                          }
  79   2                        
  80   2          }
  81   1              EA = 1;
  82   1      }
  83          void UART0_Send( unsigned char *buf, unsigned int size )
  84          {
  85   1              while( busy );
  86   1              Ptr_Send = buf;
  87   1              SendCount = size;
  88   1              SCON0 |= ( 1<<1 );
  89   1              while( busy );
  90   1      }
  91          void UART0_Senddata(unsigned char buf)
  92          {
  93   1              while( busy );
  94   1              SBUF0 = buf;
  95   1              SendCount = 0;
  96   1              busy = 1;
  97   1              while( busy );
  98   1      }
