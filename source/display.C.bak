void fnshowDaiJi_JiaoZhun(void){
	uint tt;
    
	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(17);
	UART0_Senddata(0x82);
	UART0_Senddata(0x0c);
	UART0_Senddata(0x50);
	
	if(rbuf[8]==0x72){
	  if(jdq_flag)
	    UART0_Send("  继电器  打开",14);
	  else 
	    UART0_Send("  继电器  关闭",14);
	}
	else if(rbuf[8]==0x79){
	    UART0_Send("指示光亮度调节",14);

	}
	else if(rbuf[8]==0x7A){
	  if(fls_flag)
	    UART0_Send("指示光    闪烁",14);
	  else 
	    UART0_Send("指示光    恒亮",14);
	}
	else if(rbuf[8]==0x7B){
	  if(gzall_flag)
	    UART0_Send("    光闸  打开",14);
	  else 
	    UART0_Send("    光闸  关闭",14);
	}
	else if(rbuf[8]==0x7C){
	  if(one_orflag)
	    UART0_Send("    单腔  工作",14);
	  else 
	    UART0_Send("    多腔  工作",14);
	}
	else if(rbuf[8]==0x7D){
	  if(yra_flag)
	    UART0_Send("  A 腔    预燃",14);
	  else 
	    UART0_Send("  A 腔  未预燃",14);
	}
	else if(rbuf[8]==0x7F){
	  if(yrb_flag)
	    UART0_Send("  B 腔    预燃",14);
	  else 
	    UART0_Send("  B 腔  未预燃",14);
	}
	else if(rbuf[8]==0x7E){
	    UART0_Send("优先工作的腔",12);
		if (ucChoiceABlight==ALight)
			UART0_Send(" A",2);
		else if (ucChoiceABlight==BLight)
		    UART0_Send(" B",2);
	}
	
	else if(rbuf[8]==0x80){
		tt=Pulse_time*50;
	    UART0_Send("脉宽： ",7);	
		UART0_Senddata(0x30+tt/100);
		UART0_Senddata(0x30+tt/10%10);
		UART0_Senddata(0x30+tt%10);
		UART0_Send("us  ",4);	
	}							 

	else if(rbuf[8]==0x81){
	  UART0_Send("进入",4);
	  UART0_Senddata(0xB4);//待
	  UART0_Senddata(0xFD);
	  UART0_Send("机状态  ",8);
	}	
	else if(rbuf[8]==0x82)
	  UART0_Send("进入准备状态  ",14);


}

void fnshowzhiliao_JiaoZhun(void){

    UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(17);
	UART0_Senddata(0x82);
	UART0_Senddata(0x0c);
	UART0_Senddata(0x50);   	
	if ( SJTA0==1&&SJTA1==0){
    	UART0_Send("激光",4);
		UART0_Senddata(0xD5);//
		UART0_Senddata(0xFD);
		UART0_Send("在发射  ",8);
	}
    else
  	UART0_Send("进入准备状态  ",14);  	

}


