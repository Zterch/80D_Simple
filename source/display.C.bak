void LCD_rf (  )
{	

	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(93);
	UART0_Senddata(0x82);
	UART0_Senddata(0x08);
	UART0_Senddata(0x00);
	if(data_rf[0]==0x01&&data_rf[1]==0x01)
		UART0_Send("爱科凯能--1000u",15);
	else if(data_rf[0]==0x01&&data_rf[1]==0x02)
		UART0_Send("爱科凯能---500u",15);
	UART0_Senddata(0x0D);
	UART0_Senddata(0x0A);
	UART0_Send("效期：",6);
  	UART0_Senddata(data_rf[2]/10+0x30);
	UART0_Senddata(data_rf[2]%10+0x30);
  	UART0_Senddata(data_rf[3]/10+0x30);
	UART0_Senddata(data_rf[3]%10+0x30);
	UART0_Senddata(data_rf[4]/10+0x30);
	UART0_Senddata(data_rf[4]%10+0x30);
	UART0_Senddata(data_rf[5]/10+0x30);
	UART0_Senddata(data_rf[5]%10+0x30);
	UART0_Send("----",4);
	UART0_Senddata(data_rf[6]/10+0x30);
	UART0_Senddata(data_rf[6]%10+0x30);
  	UART0_Senddata(data_rf[7]/10+0x30);
	UART0_Senddata(data_rf[7]%10+0x30);
	UART0_Senddata(data_rf[8]/10+0x30);
	UART0_Senddata(data_rf[8]%10+0x30);
	UART0_Senddata(data_rf[9]/10+0x30);
	UART0_Senddata(data_rf[9]%10+0x30);
	UART0_Senddata(0x0D);
	UART0_Senddata(0x0A);
	UART0_Send("已用次数：",10);
  	UART0_Senddata(data_rf[10]/10+0x30);
	UART0_Senddata(data_rf[10]%10+0x30);
  	UART0_Send("剩余次数：",10);
  	UART0_Senddata(data_rf[11]/10+0x30);
	UART0_Senddata(data_rf[11]%10+0x30);
	UART0_Senddata(0x0D);
	UART0_Senddata(0x0A);
	UART0_Send("传输能量：",10);
	UART0_Senddata(data_rf[12]/10+0x30);
	UART0_Senddata(data_rf[12]%10+0x30);
  	UART0_Senddata(data_rf[13]/10+0x30);
	UART0_Senddata(data_rf[13]%10+0x30);
	UART0_Senddata(data_rf[14]/10+0x30);
	UART0_Senddata(data_rf[14]%10+0x30);
	UART0_Senddata(data_rf[15]/10+0x30);
	UART0_Senddata(data_rf[15]%10+0x30);
	UART0_Send("J",1);

}

void MF_Display_2302(void){
    UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(33);
	UART0_Senddata(0x82);
	UART0_Senddata(0x08);
	UART0_Senddata(0xa0);
	UART0_Send("水温：",6);
	UART0_Senddata(temperature_SW/100+0x30);
	UART0_Senddata(temperature_SW%100/10+0x30);
	UART0_Send(".",1);
	UART0_Senddata(temperature_SW%10+0x30);
	UART0_Send("℃ ",2);
	UART0_Send("环境：",6);
	UART0_Senddata(temperature_HJ/100+0x30);
	UART0_Senddata(temperature_HJ%100/10+0x30);
	UART0_Send(".",1);
	UART0_Senddata(temperature_HJ%10+0x30);
	UART0_Send("℃ ",2);
	UART0_Senddata(humidity_HJ/100+0x30);
	UART0_Senddata(humidity_HJ%100/10+0x30);
	UART0_Send(".",1);
	UART0_Senddata(humidity_HJ%10+0x30);
	UART0_Send("RH",2);

}

void MF_Display_detectA(void){
    UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(5);
	UART0_Senddata(0x82);
	UART0_Senddata(0x0C);
	UART0_Senddata(0x3A);
	detect_VA= detect_VA*0.28125;    //detect_VA*2.4/4096*4*120
	UART0_Senddata(detect_VA/256);
	UART0_Senddata(detect_VA%256);
}

void MF_Display_detectB(void){
    UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(5);
	UART0_Senddata(0x82);
	UART0_Senddata(0x0C);
	UART0_Senddata(0x4A);
	detect_VB= detect_VB*0.28125;    //detect_VA*2.4/4096*4*120
	UART0_Senddata(detect_VB/256);
	UART0_Senddata(detect_VB%256);
}


