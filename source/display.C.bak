void LCD_Pulsetime ()
{
	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(0x11);
	UART0_Senddata(0x82);
	UART0_Senddata(0x00);
	UART0_Senddata(0x80);
	if(rbuf[8]==0x18)								
		UART0_Send("左踏板窄脉宽  ",14);
	else if(rbuf[8]==0x19)								
		UART0_Send("左踏板宽脉宽  ",14);
	else if(rbuf[8]==0x1A)								
		UART0_Send("右踏板窄脉宽  ",14);
	else if(rbuf[8]==0x1B)								
		UART0_Send("右踏板宽脉宽  ",14);
}

