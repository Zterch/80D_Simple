void LCD_CheckFeetSwitch (void)
{/*      请关机    检查脚踏开关接线*/
	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(0x11);
	UART0_Senddata(0x82);
	UART0_Senddata(0x00);
	UART0_Senddata(0x80);								
	UART0_Send("请检查脚踏开关",14); 
}

