
#include "include\includes.h"






uchar *Ptr_Send = 0;/*发送字符串指针*/
 uint SendCount = 0;/*串口发送字节计数*/
 uchar busy = 0;/*串口发送字节串完毕标志，=1 未完成=0已完成*/
 uint RevCount=0;/*串口接收字节计数*/
 
uchar idata rinterrupt=rinterrupt_No; 
uchar idata rinterrupt_ld=rinterrupt_No;	  
uchar idata rbuf[13];




/*
================================================================================
* Name        : UART0_Init( )
* Description : Initialize the UART0, baudrate
* Input       : None
* Output      : None
* Note        : None
================================================================================
*/

void UART0_Init( void )
{ 
  
   SCON0   = 0x50;                     // SCON0: mode 1, 8-bit UART, enable RX
   TMOD   |= 0x20;                     // TMOD: timer 1, mode 2, 8-bit reload
   TH1    = 256-(SYSCLK/BAUDRATE/16);     // set Timer1 reload value for baudrate
   TR1    = 1;                         // start Timer1
   CKCON  = 0x10;                      // Timer1 uses SYSCLK as time base
   PCON  |= 0x80;                      // SMOD00 = 1
   TI0    = 1;                         // Indicate TX0 ready
   IE |= 0x10;
 
}

static UART0_ISR( void ) interrupt 4
{  
   EA = 0;
    if( SCON0 & ( 1<<1 ) )
    {
        //TX ok
        SCON0 &= ~( 1<<1 );
		if( SendCount != 0 )
		{
		 	SBUF0 = *Ptr_Send++;
			SendCount--;
			busy = 1;
		} 
		else
		{
		 	busy = 0;
		}

    }
    else if( SCON0 & ( 1<<0 ) )
    { 
       //RX ok
        SCON0 &= ~( 1<<0 );
        rbuf[RevCount] = SBUF0;
		if(rbuf[0]==0x5a)					
		  RevCount++;		
		if(RevCount==9)
		{
		  if (rbuf[0]==0x5A&&rbuf[1]==0xa5&&rbuf[2]==0x06&&rbuf[3]==0x83&&rbuf[4]==0x00&&rbuf[6]==0x01&&rbuf[7]==0x00){
		     if(rbuf[5]==0x50)
			 	rinterrupt = rinterrupt_Yes;
		     if(rbuf[5]==0x51)
			 	rinterrupt_ld = rinterrupt_Yes;
			 RevCount=0;
		  }
		}else if(RevCount==13)
		{
		  if (rbuf[0]==0x5A&&rbuf[1]==0xa5&&rbuf[2]==0x0a&&rbuf[3]==0x81&&rbuf[4]==0x20&&rbuf[5]==0x07){
		     real_time_flag=1;
			 RevCount=0;
		  }
		}else if(RevCount>13){
			 RevCount=0;
			 rbuf[0]=0x00;
		}
		  
    }
	EA = 1;
}
void UART0_Send( unsigned char *buf, unsigned int size )
{
	while( busy );
	Ptr_Send = buf;
	SendCount = size;
	SCON0 |= ( 1<<1 );
	while( busy );
}
void UART0_Senddata(unsigned char buf)
{
	while( busy );
	SBUF0 = buf;
	SendCount = 0;
	busy = 1;
	while( busy );
}

void read_realtime(void)
{
	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(0x03);
	UART0_Senddata(0x81);
	UART0_Senddata(0x20);
	UART0_Senddata(0x07);

}


void change_picture(uchar pic_id)
{
	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(0x04);
	UART0_Senddata(0x80);
	UART0_Senddata(0x03);
	UART0_Senddata(0x00);
	UART0_Senddata(pic_id);

}

void Display_Frequency_left ( uchar FrequencyByte )
{
	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(0x05);
	UART0_Senddata(0x82);
	UART0_Senddata(0x00);
	UART0_Senddata(0x20);			
	UART0_Senddata(FrequencyByte/10+0x30);			
	UART0_Senddata(FrequencyByte%10+0x30);									
																																																					
}

 void Display_Energy_left ( uchar EnergyByte )
{
	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(0x06);
	UART0_Senddata(0x82);
	UART0_Senddata(0x00);
	UART0_Senddata(0x30);		
	UART0_Senddata(EnergyByte/10+0x30);
	UART0_Send(".",1);
	UART0_Senddata(EnergyByte%10+0x30);				
						
}
