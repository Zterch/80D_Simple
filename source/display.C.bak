	UART0_Send("SDYOT_B:-",9);
	UART0_Senddata(SDYOT_B|0x30);
	UART0_Senddata(0x0D);
	UART0_Senddata(0x0A);

	UART0_Send("SWGZ0:---",9);
	UART0_Senddata(SWGZ0|0x30);
	UART0_Send("    ",4);
	UART0_Send("SWGZ:----",9);
	UART0_Senddata(SWGZ|0x30);
	UART0_Senddata(0x0D);
	UART0_Senddata(0x0A);

	UART0_Send("SJTA0:---",9);
