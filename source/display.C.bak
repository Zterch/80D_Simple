{
	if(EnergyByte>=900){
	  EnergyByte=900;
	}

	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(0x07);
	UART0_Senddata(0x82);
	UART0_Senddata(0x00);
	UART0_Senddata(0x40);
	 if(EnergyByte>=100){		
	    UART0_Senddata(EnergyByte/100+0x30);			
		UART0_Senddata(EnergyByte%100/10+0x30);
		UART0_Send(".",1);
		UART0_Senddata(EnergyByte%10+0x30);	
	}else{
	    UART0_Senddata(EnergyByte%100/10+0x30);
		UART0_Send(".",1);
		UART0_Senddata(EnergyByte%10+0x30);	
		UART0_Send(" ",1);

	}

						
}





