void SysFault(uchar i)
{    
	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(0x11);
	UART0_Senddata(0x82);
	UART0_Senddata(0x00);
	UART0_Senddata(0x80);
	UART0_Send("系统故障    ",12);
	UART0_Senddata(0x30+i/10);										
	UART0_Senddata(0x30+i%10);
 	
}


