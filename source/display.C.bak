void MF_1fnshow(void){

    UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(17);
	UART0_Senddata(0x82);
	UART0_Senddata(0x08);
	UART0_Senddata(0xD0);
	
	if(rbuf[8]==0x51){
	  if(gzall_flag)
	    UART0_Send("    光闸  打开",14);
	  else 
	    UART0_Send("    光闸  关闭",14);
	}
	else if(rbuf[8]==0x52){
	  if(yr_flag)
	    UART0_Send("  预燃        ",14);
	  else 
	    UART0_Send("不预燃        ",14);
	}
	else if(rbuf[8]==0x53){
	    UART0_Send("指示光亮度调节",14);

	} 
	else if(rbuf[8]==0x54){
	  if(fls_flag)
	    UART0_Send("指示光    闪烁",14);
	  else 
	    UART0_Send("指示光    恒亮",14);
	}else if(rbuf[8]==0x55){
	  if(jdq_flag)
	    UART0_Send("继电器    闭合",14);
	  else 
	    UART0_Send("继电器    断开",14);
	}else if(rbuf[8]==0x56){
	  
	  if(onf_flag){
		  UART0_Send("RF正常写入    ",14);
		}else{
		  UART0_Send("RF异常        ",14);
		} 

	}else if(rbuf[8]==0x57){
	  if(jsy_flag){
	    if(onf_flag){
		  UART0_Send("RF正常读取    ",14);
		}else{
		  UART0_Send("RF异常        ",14);
		} 		
	  }
	  else{ 
	    if(onf_flag){
		  UART0_Send("RF正常写入    ",14);
		}else{
		  UART0_Send("RF异常        ",14);
		} 
	  }
	}
}

void fnShowStatus(void)
{	   
	P7status=P7;
	P6status=P6;
	P5status=P5;
	P4status=P4;

	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(159);	 //数据+指令每次不得大于256
	UART0_Senddata(0x82);
	UART0_Senddata(0x06);
	UART0_Senddata(0x00);
	UART0_Send("SDYOV_A:-",9);
	UART0_Senddata(SDYOV_A|0x30);
	UART0_Send("    ",4);
	UART0_Send("SDYOT_A:-",9);
	UART0_Senddata(SDYOT_A|0x30);
	UART0_Senddata(0x0D);
	UART0_Senddata(0x0A);

