void Display_FeedBackEnergyVolt_left(uint cc){
	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(7);
	UART0_Senddata(0x82);
	UART0_Senddata(0x00);
	UART0_Senddata(0xa0);
	UART0_Senddata(cc/100+0x30); 
	UART0_Send(".",1);
	UART0_Senddata(cc%100/10+0x30);
	UART0_Senddata(cc%10+0x30);
	
}



