	UART0_Send("    ",4);
	UART0_Send("ST2:-----",9);
	UART0_Senddata(ST2|0x30);
	UART0_Senddata(0x0D);
	UART0_Senddata(0x0A);

	UART0_Send("ST3:-----",9);
	UART0_Senddata(ST3|0x30);
	UART0_Send("    ",4);
	UART0_Send("ST4:-----",9);
	UART0_Senddata(ST4|0x30);
	UART0_Senddata(0x0D);
	UART0_Senddata(0x0A);

	UART0_Send("SCPL:----",9);
	UART0_Senddata(SCPL|0x30);
	UART0_Send("    ",4);
	UART0_Send("SCPH:----",9);
	UART0_Senddata(SCPH|0x30);
	UART0_Senddata(0x0D);
	UART0_Senddata(0x0A);

	UART0_Send("SLQSL_A:-",9);
