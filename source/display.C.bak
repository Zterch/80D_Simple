    UART0_Senddata(5);
	UART0_Senddata(0x82);
	UART0_Senddata(0x09);
	UART0_Senddata(0x10);
	UART0_Senddata(cc/256);
	UART0_Senddata(cc%256);


}

void fn_TotalPulseJoule(void){
    
	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(6);
	UART0_Senddata(0x82);
	UART0_Senddata(0x0b);
	UART0_Senddata(0x10);
	UART0_Senddata(TotalJoule_U/65536);
	UART0_Senddata(TotalJoule_U%65536/256);
	UART0_Senddata(TotalJoule_U%256);

	Delay (2000);

	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(6);
	UART0_Senddata(0x82);
	UART0_Senddata(0x0b);
	UART0_Senddata(0x30);
	UART0_Senddata(TotalPulse_U/65536);
	UART0_Senddata(TotalPulse_U%65536/256);
	UART0_Senddata(TotalPulse_U%256);

}

