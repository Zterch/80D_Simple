void fnShowwork_info_lishiqingchu(uchar cccc )
{	   
	uchar dizhi_h,dizhi_l;
	if(cccc==1){
	  dizhi_h=0x10;
	  dizhi_l=0x00;
	}else if(cccc==2){
	  dizhi_h=0x10;
	  dizhi_l=0x70;
	}else if(cccc==3){
	  dizhi_h=0x11;
	  dizhi_l=0x00;
	}else if(cccc==4){
	  dizhi_h=0x11;
	  dizhi_l=0x70;
	}else if(cccc==5){
	  dizhi_h=0x12;
	  dizhi_l=0x00;
	}else if(cccc==6){
	  dizhi_h=0x12;
	  dizhi_l=0x70;
	}else if(cccc==7){
	  dizhi_h=0x13;
	  dizhi_l=0x00;
	}else if(cccc==8){
	  dizhi_h=0x13;
	  dizhi_l=0x70;
	}else if(cccc==9){
	  dizhi_h=0x14;
	  dizhi_l=0x00;
	}else if(cccc==10){
	  dizhi_h=0x14;
	  dizhi_l=0x70;
	}
	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(45);	 //数据+指令每次不得大于256
	UART0_Senddata(0x82);
	UART0_Senddata(dizhi_h);
	UART0_Senddata(dizhi_l);	
	UART0_Send("                                          ",42);
	Delay( 1000 );
	Delay( 1000 );

}

void fnShowwork_info_lishi(uchar cccc )
{	   
	uchar dizhi_h,dizhi_l;
	ulong maichong,nengliang,shijian;
	maichong=work_info_read[6]*65536+work_info_read[7]*256+work_info_read[8];
	nengliang=work_info_read[9]*65536+work_info_read[10]*256+work_info_read[11];
	shijian=work_info_read[12]*256+work_info_read[13];
	if(cccc==1){
	  dizhi_h=0x10;
	  dizhi_l=0x00;
	}else if(cccc==2){
	  dizhi_h=0x10;
	  dizhi_l=0x70;
	}else if(cccc==3){
	  dizhi_h=0x11;
	  dizhi_l=0x00;
	}else if(cccc==4){
	  dizhi_h=0x11;
	  dizhi_l=0x70;
	}else if(cccc==5){
	  dizhi_h=0x12;
	  dizhi_l=0x00;
	}else if(cccc==6){
	  dizhi_h=0x12;
	  dizhi_l=0x70;
	}else if(cccc==7){
	  dizhi_h=0x13;
	  dizhi_l=0x00;
	}else if(cccc==8){
	  dizhi_h=0x13;
	  dizhi_l=0x70;
	}else if(cccc==9){
	  dizhi_h=0x14;
	  dizhi_l=0x00;
	}else if(cccc==10){
	  dizhi_h=0x14;
	  dizhi_l=0x70;
	}
	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(45);	 //数据+指令每次不得大于256
	UART0_Senddata(0x82);
	UART0_Senddata(dizhi_h);
	UART0_Senddata(dizhi_l);	
	UART0_Senddata((work_info_read[0]/16)|0x30);
	UART0_Senddata((work_info_read[0]%16)|0x30);
	UART0_Send("/",1);
	UART0_Senddata((work_info_read[1]/16)|0x30);
	UART0_Senddata((work_info_read[1]%16)|0x30);
	UART0_Send("/",1);
	UART0_Senddata((work_info_read[2]/16)|0x30);
	UART0_Senddata((work_info_read[2]%16)|0x30);
	UART0_Send(" ",1);
	UART0_Senddata((work_info_read[3]/16)|0x30);
	UART0_Senddata((work_info_read[3]%16)|0x30);
	UART0_Send(":",1);
	UART0_Senddata((work_info_read[4]/16)|0x30);
	UART0_Senddata((work_info_read[4]%16)|0x30);
	UART0_Send(":",1);
	UART0_Senddata((work_info_read[5]/16)|0x30);
	UART0_Senddata((work_info_read[5]%16)|0x30);
	UART0_Send("  ",2);
	
	UART0_Senddata((maichong/1000000)|0x30);	  //共7位显示
	UART0_Senddata((maichong/100000%10)|0x30);
	UART0_Senddata((maichong/10000%10)|0x30);
	UART0_Senddata((maichong/1000%10)|0x30);
	UART0_Senddata((maichong/100%10)|0x30);
	UART0_Senddata((maichong/10%10)|0x30);
	UART0_Senddata((maichong%10)|0x30);
	UART0_Send("  ",2);
	
	UART0_Senddata((nengliang/1000000)|0x30);	  //共7位显示
	UART0_Senddata((nengliang/100000%10)|0x30);
	UART0_Senddata((nengliang/10000%10)|0x30);
	UART0_Senddata((nengliang/1000%10)|0x30);
	UART0_Senddata((nengliang/100%10)|0x30);
	UART0_Senddata((nengliang/10%10)|0x30);
	UART0_Senddata((nengliang%10)|0x30);
	UART0_Send("  ",2);
	
	UART0_Senddata((shijian/1000)|0x30);	  //共4位显示
	UART0_Senddata((shijian/100%10)|0x30);
	UART0_Senddata((shijian/10%10)|0x30);
	UART0_Send(".",1);
	UART0_Senddata((shijian%10)|0x30);
	Delay( 1000 );
	Delay( 1000 );
}

void fnShowwork_info_benci(void )
{
    UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(10);	 //数据+指令每次不得大于256
	UART0_Senddata(0x82);
	UART0_Senddata(0x16);
	UART0_Senddata(0x00);
	UART0_Senddata((TotalPulse_benci/1000000)|0x30);	  //共7位显示
	UART0_Senddata((TotalPulse_benci/100000%10)|0x30);
	UART0_Senddata((TotalPulse_benci/10000%10)|0x30);
	UART0_Senddata((TotalPulse_benci/1000%10)|0x30);
	UART0_Senddata((TotalPulse_benci/100%10)|0x30);
	UART0_Senddata((TotalPulse_benci/10%10)|0x30);
	UART0_Senddata((TotalPulse_benci%10)|0x30);
	Delay( 1000 );

	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(10);	 //数据+指令每次不得大于256
	UART0_Senddata(0x82);
	UART0_Senddata(0x16);
	UART0_Senddata(0x10);
	UART0_Senddata((TotalJoule_benci_1/1000000)|0x30);	  //共7位显示
	UART0_Senddata((TotalJoule_benci_1/100000%10)|0x30);
	UART0_Senddata((TotalJoule_benci_1/10000%10)|0x30);
	UART0_Senddata((TotalJoule_benci_1/1000%10)|0x30);
	UART0_Senddata((TotalJoule_benci_1/100%10)|0x30);
	UART0_Senddata((TotalJoule_benci_1/10%10)|0x30);
	UART0_Senddata((TotalJoule_benci_1%10)|0x30);
	Delay( 1000 );

	UART0_Senddata(0x5a);
	UART0_Senddata(0xa5);
    UART0_Senddata(8);	 //数据+指令每次不得大于256
	UART0_Senddata(0x82);
	UART0_Senddata(0x16);
	UART0_Senddata(0x20);
	UART0_Senddata(((uint)Totalminutes_benci/1000)|0x30);	  //共4位显示
	UART0_Senddata(((uint)Totalminutes_benci/100%10)|0x30);
	UART0_Senddata(((uint)Totalminutes_benci/10%10)|0x30);
	UART0_Send(".",1);
	UART0_Senddata(((uint)Totalminutes_benci%10)|0x30);
	Delay( 1000 );

}


