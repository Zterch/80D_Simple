 123          //22.1184M
 124          void Oscillator_Init()
 125          {
 126   1          int i = 0;
 127   1          OSCXCN    = 0x67;            //选用外部晶体振荡器 频率大于6.7M
 128   1          for (i = 0; i < 3000; i++);  // Wait 1ms for initialization
 129   1          while ((OSCXCN & 0x80) == 0);//XTLVLD 等待晶体振荡器有效标志位 置位ckcon
 130   1          OSCICN    = 0x88;            //允许检测时钟丢失 选择外部晶振 
 131   1      }
 132          
 133          void Timer0Init( void )
 134          {
 135   1        TMOD   |= 0x01; //16位定时模式                  
 136   1        TL0 = (65536-92)%256;     //系统时钟12分频 作为定时器2时钟源             
 137   1        TH0 = (65536-92)/256;     //精度可以满足   此定时为50us，准确数为49.945us   精度1%    
 138   1        ET0=1;
 139   1      }
 140          
 141          void Timer3Init( void )
 142          { 
 143   1          TMR3CN    = 0x04;                   //定时器3启动
 144   1          TMR3RLL   = (65536-18400)%256;      //系统时钟12分频 作为定时器3时钟源
 145   1          TMR3RLH   = (65536-18400)/256;      //定时10ms
 146   1          EIE2     |= 0x01;                   //允许定时器3中断
 147   1      }
